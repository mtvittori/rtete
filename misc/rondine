#!/usr/bin/env bash
# Rondine — client Telegram TUI (~/Work/rondine).
# Avvia il client nel miglior terminale disponibile per gli sticker:
# kitty (kitty graphics protocol) → ghostty → wezterm → terminale di sistema.
# Dentro foot gira sul posto: lì gli sticker passano da sixel.
# Senza grafica sono visibili solo le etichette emoji.
# Errori del client (stderr) finiscono su ~/.local/state/rondine.err.log:
# la TUI usa solo stdout, quindi la visualizzazione resta intatta.
set -uo pipefail

bin="$HOME/Work/rondine/target/release/rondine"
# il progetto può stare ancora nella cartella col vecchio nome
[[ -x $bin ]] || bin="$HOME/Work/rtete/target/release/rondine"
if [[ ! -x $bin ]]; then
  echo "rondine: binario non trovato." >&2
  echo "Compila: ~/.cargo/bin/cargo build --release  (in ~/Work/rondine)" >&2
  read -r -p "Premi Invio per chiudere "; exit 1
fi
mkdir -m 700 -p "$HOME/.local/state"
touch "$HOME/.local/state/rondine.err.log" && chmod 600 "$HOME/.local/state/rondine.err.log"

# foot di Omarchy dichiara TERM=xterm-256color: lo si riconosce dal
# processo antenato (stesso controllo di gfx.rs nel client).
in_foot() {
  [[ ${TERM:-} == foot* ]] && return 0
  local pid=$PPID comm
  while (( pid > 1 )); do
    comm=$(<"/proc/$pid/comm") 2>/dev/null || return 1
    [[ $comm == foot || $comm == footclient ]] && return 0
    # stat: «pid (comm) stato ppid …»; comm può contenere spazi
    # (tmux: «tmux: server»), quindi si legge dopo l'ultima «) »
    pid=$(<"/proc/$pid/stat") 2>/dev/null || return 1
    pid=${pid##*) }; pid=${pid#* }; pid=${pid%% *}
    [[ $pid =~ ^[0-9]+$ ]] || return 1
  done
  return 1
}

# Già dentro un terminale compatibile: esegui qui, senza aprire finestre.
if in_foot || [[ -n ${KITTY_WINDOW_ID:-} || -n ${GHOSTTY_RESOURCES_DIR:-} || -n ${WEZTERM_PANE:-} ]]; then
  exec "$bin"
fi

if command -v kitty >/dev/null 2>&1; then
  # Il log stderr non tocca la TUI (che scrive su stdout); in caso di errore
  # la finestra resta aperta mostrando le ultime righe di log finché Invio.
  exec kitty --class Rondine --title Rondine /bin/bash -c '
    rc=0; "$1" 2>>"$2" || rc=$?
    # 130 = SIGINT, 143 = SIGTERM: chiusure volute (pkill/menu) → niente schermata
    if (( rc != 0 && rc != 130 && rc != 143 )); then
      echo
      echo "== rondine è uscito con errore ($rc). Ultimo log: =="
      tail -6 "$2"
      echo
      read -r -p "Premi Invio per chiudere "
    fi' _ "$bin" "$HOME/.local/state/rondine.err.log"
elif command -v ghostty >/dev/null 2>&1; then
  exec ghostty --class=Rondine --title=Rondine "$bin" 2>>"$HOME/.local/state/rondine.err.log"
elif command -v wezterm >/dev/null 2>&1; then
  exec wezterm start --always-new-process -- "$bin"
elif command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec xdg-terminal-exec -e "$bin"
else
  exec "$bin"
fi
