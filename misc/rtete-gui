#!/usr/bin/env bash
# RTete GUI — client Telegram grafico (iced) di ~/Work/rtete.
# Gli errori finiscono su ~/.local/state/rtete-gui.err.log.
# Con la TUI aperta non parte: le due condividerebbero la stessa sessione
# sqlite (~/.local/share/rtete/rtete.db) nello stesso momento.
set -uo pipefail

bin="$HOME/Work/rtete/target/release/rtete-gui"
if [[ ! -x $bin ]]; then
  notify-send -a RTete "RTete" "Binario non trovato: compila con
cargo build --release --features gui --bin rtete-gui" 2>/dev/null
  exit 1
fi
if pgrep -x rtete >/dev/null; then
  notify-send -a RTete "RTete" "La versione da terminale è aperta: chiudila prima (usano la stessa sessione)." 2>/dev/null
  exit 1
fi
mkdir -m 700 -p "$HOME/.local/state"
log="$HOME/.local/state/rtete-gui.err.log"
touch "$log" && chmod 600 "$log"
exec "$bin" 2>>"$log"
